# HAONLINE server configuration (copy to .env)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080

# Data directory (SQLite database, uploads, backups)
DATA_DIR=./data

# Web client directory. Use ./dist/web after `npm run web:build` for production.
WEB_DIR=./web

# REQUIRED in production: long random secret used to hash session/token material
APP_SECRET=change-me-to-a-long-random-string

# Registration / email verification
MAIL_DEV_MODE=true
MAIL_FROM=no-reply@haonline.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Web Push (VAPID) - optional, enables browser push delivery
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@haonline.local

# Payments (optional). When unset, monetization runs in ledger-only mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Upload limits
MAX_UPLOAD_MB=200

# Comma separated allowed origins for CORS (mobile/iOS/Windows clients)
CORS_ORIGINS=

# Session lifetime in days
SESSION_DAYS=30
